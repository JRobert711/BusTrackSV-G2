# Backend API URL - Required in production
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Development server configuration (optional)
# VITE_DEV_SERVER_PORT=3000
# VITE_DEV_SERVER_HOST=localhost

# Mapbox API configuration
# Get your token from https://account.mapbox.com/access-tokens/
VITE_MAPBOX_TOKEN=your_mapbox_token_here

# Map center and bounds (optional, defaults to El Salvador)
# VITE_MAP_CENTER_LAT=13.7942
# VITE_MAP_CENTER_LNG=-88.9149
# VITE_MAP_BOUNDS_SW_LAT=13.6
# VITE_MAP_BOUNDS_SW_LNG=-89.4
# VITE_MAP_BOUNDS_NE_LAT=13.8
# VITE_MAP_BOUNDS_NE_LNG=-89.1

# Bus stops configuration (optional, JSON array)
# Example: VITE_BUS_STOPS=[{"id":"stop-1","name":"Terminal","position":{"lat":13.7209,"lng":-89.2331}}]

# Available routes and drivers (optional, JSON arrays)
# TODO: These should ideally come from the backend API
# Example: VITE_AVAILABLE_ROUTES=["101","102","201"]
# Example: VITE_AVAILABLE_DRIVERS=["Carlos Rodríguez","María González"]
# VITE_DEFAULT_ROUTE=101

